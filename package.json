{
  "name": "maccabi-kfar-saba-team-manager",
  "private": true,
  "version": "0.1.0",
  "description": "SQUADRIX — Football Team Operations",
  "author": "SQUADRIX",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/copy-landing.cjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "desktop": "npm.cmd run build && electron .",
    "desktop:package": "npm.cmd run build && electron-builder --win nsis portable",
    "desktop:msix": "npm.cmd run build && electron-builder --win appx --config.directories.output=release-msix"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@netlify/functions": "^3.1.10",
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "react-router-dom": "^7.8.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.3"
  },
  "build": {
    "appId": "il.squadrix.desktop",
    "productName": "SQUADRIX",
    "icon": "build/icon.png",
    "copyright": "Copyright © 2026 SQUADRIX",
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "directories": { "buildResources": "build", "output": "release-desktop" },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "SQUADRIX-Setup-${version}.${ext}"
    },
    "portable": { "artifactName": "SQUADRIX-Portable-${version}.${ext}" },
    "appx": {
      "artifactName": "SQUADRIX-${version}-Windows.msix",
      "identityName": "FrostigKnowledgeTransfer.squadrix",
      "applicationId": "squadrix",
      "displayName": "SQUADRIX Football Team Operations",
      "publisher": "CN=8D5E8299-C1EE-4376-8783-93E12C1B31BC",
      "publisherDisplayName": "Frostig Knowledge Transfer",
      "backgroundColor": "#061D39",
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0",
      "languages": ["he-IL", "en-US"]
    }
  }
}
